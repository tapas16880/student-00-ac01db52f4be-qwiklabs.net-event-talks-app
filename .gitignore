# Gitignore for a simple web project

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime files
.sass-cache/
.project
.idea/
.vs/
.vscode/

# Dependencies
node_modules/
jspm_packages/

# Temp files
*.tmp
*.temp
*.swp
*.swo

# macOS specific files
.DS_Store

# Windows specific files
Thumbs.db

# Output of build tools
dist/
build/
.cache/
.parcel-cache/
